---
// CSS-only card visual, for projects with no screenshots yet. Each swatch is
// built from that client's own brand colours — a florist's pinks, a grower's
// greens — so the index grid still reads as four distinct shops rather than
// four grey placeholders. These are client colours, deliberately outside the
// site's own kraft/brick chrome, and shouldn't be re-themed with it.
interface Props {
  variant: 'artisan' | 'blooms' | 'flavour' | 'plants';
  name: string;
  inProgress?: boolean;
}

const { variant, name, inProgress = false } = Astro.props;
---

{
  variant === 'artisan' && (
    <span class="sw sw--artisan">
      <span class="sw-rule" aria-hidden="true"></span>
      <span class="sw-mark sw-mark--cormorant">{name}</span>
      <span class="sw-tiles" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </span>
  )
}

{
  variant === 'flavour' && (
    <span class="sw sw--flavour">
      <span class="sw-mark sw-mark--stamp">{name}</span>
    </span>
  )
}

{
  variant === 'blooms' && (
    <span class="sw sw--blooms">
      <svg class="sw-bloom" viewBox="0 0 44 44" fill="none" aria-hidden="true">
        <g fill="#C46A8B">
          <circle cx="22" cy="12" r="8" />
          <circle cx="22" cy="32" r="8" />
          <circle cx="12" cy="22" r="8" />
          <circle cx="32" cy="22" r="8" />
        </g>
        <circle cx="22" cy="22" r="6" fill="#7A2E4C" />
      </svg>
      <span class="sw-mark">{name}</span>
      <span class="sw-caldots" aria-hidden="true">
        <span />
        <span />
        <span />
        <span />
        <span />
        <span />
      </span>
    </span>
  )
}

{
  variant === 'plants' && (
    <span class="sw sw--plants">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M20 36 C20 22 8 18 8 6 C22 6 26 18 20 36 Z" fill="#EDE7DA" />
        <path d="M20 36 C20 22 32 18 32 6 C18 6 14 18 20 36 Z" fill="#DCE7D2" opacity="0.85" />
      </svg>
      <span class="sw-mark sw-mark--light">{name}</span>
      {inProgress && <span class="sw-badge">In progress</span>}
    </span>
  )
}

<style>
  .sw {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    overflow: hidden;
  }

  .sw-mark {
    font-family: var(--ps2-disp);
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.01em;
    text-align: center;
    padding: 0 16px;
  }

  /* ---------- the artisan merchants ---------- */
  .sw--artisan {
    background: #1B2A46;
    gap: 12px;
  }

  .sw-rule {
    width: 40%;
    height: 1px;
    background: #B08D4E;
  }

  .sw-mark--cormorant {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 24px;
    color: #F1E9D6;
    letter-spacing: 0.01em;
  }

  .sw-tiles {
    display: flex;
    gap: 9px;
  }

  .sw-tiles span {
    width: 34px;
    height: 34px;
    background: #F1E9D6;
    border: 1px solid #B08D4E;
  }

  /* ---------- flavour like fancy ---------- */
  .sw--flavour {
    background: linear-gradient(135deg, #E8598A 0 34%, #2BB3AC 34% 67%, #F2C13B 67% 100%);
  }

  .sw-mark--stamp {
    font-weight: 800;
    font-size: 20px;
    color: #17160F;
    background: #EDE7DA;
    padding: 8px 16px;
    transform: rotate(-2deg);
    line-height: 1.2;
    max-width: 80%;
  }

  /* ---------- pretty busy blooms ---------- */
  .sw--blooms {
    background: #EFD3DC;
  }

  .sw--blooms .sw-mark {
    color: #7A2E4C;
  }

  .sw-bloom {
    width: 44px;
    height: 44px;
  }

  .sw-caldots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .sw-caldots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #C46A8B;
  }

  /* ---------- andy's airplants ---------- */
  .sw--plants {
    background: linear-gradient(180deg, #DCE7D2 0%, #33512F 100%);
  }

  .sw-mark--light {
    color: #EDE7DA;
  }

  .sw-badge {
    position: absolute;
    bottom: 13px;
    right: 13px;
    font-family: var(--ps2-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: rgba(237, 231, 218, 0.94);
    color: #2A4226;
    padding: 5px 10px;
    border-radius: 20px;
  }
</style>
