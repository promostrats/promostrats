---
import Layout from '../layouts/Layout.astro';

const ticker = [
  'custom website builds',
  'homepage restructure',
  'bespoke web design',
  'collection filter rewrite',
  'meta titles + descriptions',
  'landing pages that convert',
  'custom theme sections',
  'navigation cleanup',
  'product copy rewrites',
  'image optimisation',
];

const fixes = [
  {
    before: "visitors can't find what they need, so they leave",
    after: 'clear navigation and page structure',
    title: 'Disorganised site structure',
    body: 'Menus, collections and pages reorganised around how your customers actually shop.',
  },
  {
    before: 'missing titles, descriptions and structure',
    after: 'SEO basics set up correctly, page by page',
    title: 'SEO that was never set up',
    body: 'Meta data, URL handles, headings and product copy done properly — so search engines can find you.',
  },
  {
    before: 'confusing layouts creating friction',
    after: 'pages redesigned around one clear job',
    title: 'Pages that are hard to use',
    body: 'Custom-built theme sections that match your brand, instead of stock blocks bent out of shape.',
  },
  {
    before: 'small blockers stopping interested buyers',
    after: 'friction removed from browse to checkout',
    title: 'Conversion friction points',
    body: 'The small, unglamorous details — broken filters, slow images, unclear buttons — found and fixed.',
  },
];

const steps = [
  {
    title: 'Free strategy call',
    body: "I review your site live and tell you exactly what's working and what isn't. No obligation.",
  },
  {
    title: 'Clear recommendations',
    body: "A written breakdown of what I'd fix, why it matters, and what it costs.",
  },
  {
    title: 'Implementation',
    body: 'The work is done carefully inside your existing setup, with regular updates throughout.',
  },
  {
    title: 'Summary + next steps',
    body: "A before/after summary, plus what I'd improve next — whether or not you hire me again.",
  },
];
---

<Layout>
  <div class="ps2-home">
    <!-- status strip -->
    <div class="ps2-status">
      <div class="ps2-wrap">
        <div><b>promostrats</b> <span class="ps2-path">web design &middot; development &middot; seo &mdash; london</span></div>
        <a class="ps2-avail" href="/contact">accepting new projects</a>
      </div>
    </div>

    <!-- hero -->
    <div class="ps2-hero">
      <div class="ps2-wrap">
        <div>
          <span class="ps2-eyebrow">web design + development + seo — london</span>
          <h1>Your website, <span class="ps2-fixword">working properly</span>.</h1>
          <p class="ps2-lede">
            I design and build custom websites, and fix the structure, usability and SEO
            issues quietly costing sales on the ones already live.
          </p>
          <div class="ps2-hero-ctas">
            <a class="ps2-btn ps2-btn--ghost" href="/contact">Book your free strategy call</a>
            <a class="ps2-arrow-link" href="/portfolio">View portfolio <span>&rarr;</span></a>
          </div>
          <div class="ps2-hero-note">free 20-min call &middot; clear pricing before any work starts</div>
        </div>

        <div class="ps2-check">
          <div class="ps2-check-glow" aria-hidden="true"></div>
          <div class="ps2-check-card">
            <div class="ps2-check-head">
              <span class="ps2-check-dot"></span>
              free site check
            </div>
            <h2 class="ps2-check-title">Is your website working properly?</h2>
            <p class="ps2-check-body">Enter your URL for an instant SEO + design score &mdash; free, no email needed.</p>

            <form class="ps2-check-form" action="/site-check" method="get">
              <input type="text" name="url" inputmode="url" placeholder="https://yourbusiness.com" aria-label="Your website address" />
              <button type="submit">Check it &rarr;</button>
            </form>

            <div class="ps2-check-rings">
              <div class="ps2-check-ring">
                <div class="ps2-check-ring-circle"><span>&mdash;</span></div>
                <span class="ps2-check-ring-label">SEO</span>
              </div>
              <div class="ps2-check-ring">
                <div class="ps2-check-ring-circle"><span>&mdash;</span></div>
                <span class="ps2-check-ring-label">Design &amp; UX</span>
              </div>
              <div class="ps2-check-hint">scores appear in ~10 seconds</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ticker -->
    <div class="ps2-ticker" aria-hidden="true">
      <div class="ps2-ticker-track">
        {ticker.map((t) => <span>{t}</span>)}
        {ticker.map((t) => <span>{t}</span>)}
      </div>
    </div>

    <!-- what I fix -->
    <div class="ps2-section ps2-section--clay">
      <div class="ps2-wrap">
        <div class="ps2-sec-head">
          <span class="ps2-eyebrow">what I do</span>
          <h2 class="ps2-h2">Common problems, properly solved.</h2>
          <p>
            Whether I'm building your site from scratch or improving the one you've got, I get these right at the
            source - not with plugins stacked on plugins.
          </p>
        </div>
        <div class="ps2-diffgrid">
          {
            fixes.map((f) => (
              <div class="ps2-diff">
                <div class="ps2-diff-before">
                  <span>&times;</span>
                  <s>{f.before}</s>
                </div>
                <div class="ps2-diff-after">
                  <span>&check;</span>
                  {f.after}
                </div>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- process -->
    <div class="ps2-section ps2-process">
      <div class="ps2-wrap">
        <div class="ps2-sec-head">
          <span class="ps2-eyebrow">how it works</span>
          <h2 class="ps2-h2">Simple, transparent process.</h2>
          <p>Four steps from first conversation to finished work. You'll know the price before anything starts.</p>
        </div>
        <div class="ps2-steps">
          {
            steps.map((s) => (
              <div class="ps2-step">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- testimonial -->
    <div class="ps2-section">
      <div class="ps2-wrap">
        <span class="ps2-eyebrow">what clients say</span>
        <div class="ps2-stars" aria-label="5 out of 5 stars">&starf;&starf;&starf;&starf;&starf;</div>
        <blockquote class="ps2-quote">
          "Connor took the time to understand our business and implemented improvements across our whole site — from
          homepage layout and navigation through to <em>detailed SEO work</em> on product copy, metadata and images. Clear
          plan, measurable progress, smooth and collaborative."
        </blockquote>
        <div class="ps2-attrib">
          <div class="ps2-avatar">BM</div>
          <div><b>Ben Meekings</b><span>The Artisan Merchants</span></div>
          <a
            class="ps2-verified"
            href="https://www.google.com/maps/place/PromoStrats"
            target="_blank"
            rel="noopener">verified google review &nearr;</a
          >
        </div>
      </div>
    </div>

    <!-- about -->
    <div class="ps2-section ps2-about">
      <div class="ps2-wrap">
        <div>
          <span class="ps2-eyebrow">about</span>
          <h2 class="ps2-h2">Hello, I'm Connor Bawcutt.</h2>
          <p>
            I work with independent brands and small businesses on everything from full custom website builds to
            targeted fixes - bespoke design and sections, structured SEO plans, and the small technical details most
            agencies skip. Shopify is my specialism, but I build from scratch and on other platforms too.
          </p>
          <p>You deal with me directly the whole way through: the person on the call is the person doing the work.</p>
        </div>
        <div class="ps2-about-card">
          <div><span class="ps2-k">base:</span> London, East Dulwich</div>
          <div><span class="ps2-k">focus:</span> web design &middot; development &middot; seo</div>
          <div><span class="ps2-k">specialism:</span> shopify &middot; custom builds</div>
          <div><span class="ps2-k">clients:</span> UK independent brands</div>
          <div><span class="ps2-k">pricing:</span> quoted clearly, before work starts</div>
          <div><span class="ps2-k">contact:</span> <a href="mailto:promostrats@gmail.com">promostrats@gmail.com</a></div>
          <div><span class="ps2-k">phone:</span> <a href="tel:07514043068">07514 043068</a></div>
        </div>
      </div>
    </div>

    <!-- cta -->
    <div class="ps2-cta">
      <div class="ps2-wrap">
        <span class="ps2-eyebrow">next step</span>
        <h2 class="ps2-h2">Ready to build something better?</h2>
        <p>
          A free, no-pressure call. Whether you need a new site built or want to get more from the one you've got, I'll
          tell you exactly what I'd do - you decide what happens next.
        </p>
        <a class="ps2-btn" href="/contact">Book your free strategy call</a>
        <div class="ps2-cta-note">I usually reply same day!</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ---------- status strip ---------- */
  .ps2-status {
    background: var(--ps2-panel);
    color: var(--ps2-panel-text);
    font-family: var(--ps2-sans);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    padding: 9px 0;
  }

  .ps2-status .ps2-wrap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .ps2-status b {
    color: #fff;
    font-weight: 600;
  }

  .ps2-avail {
    color: var(--ps2-green-light);
    text-decoration: none;
  }

  .ps2-avail:hover {
    color: #A3CDB0;
  }

  .ps2-avail::before {
    content: '\25CF';
    font-size: 8px;
    vertical-align: 2px;
    margin-right: 7px;
    animation: ps2-pulse 2.4s ease-in-out infinite;
  }

  @keyframes ps2-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 640px) {
    .ps2-status .ps2-path {
      display: none;
    }
  }

  /* ---------- hero ---------- */
  .ps2-hero {
    padding: 84px 0 72px;
  }

  .ps2-hero .ps2-wrap {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: center;
  }

  .ps2-eyebrow {
    margin-bottom: 22px;
  }

  .ps2-hero h1 {
    font-family: var(--ps2-disp);
    font-weight: 800;
    font-size: clamp(38px, 5.2vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ps2-ink);
  }

  .ps2-fixword {
    position: relative;
    white-space: nowrap;
  }

  .ps2-fixword::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 10px;
    background: var(--ps2-gradient);
    opacity: 0.4;
    border-radius: 3px;
  }

  .ps2-lede {
    margin: 26px 0 34px;
    font-size: 19px;
    color: var(--ps2-ink-soft);
    max-width: 46ch;
  }

  .ps2-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .ps2-hero-note {
    margin-top: 22px;
    font-family: var(--ps2-mono);
    font-size: 12.5px;
    color: var(--ps2-ink-soft);
  }

  /* tertiary hero action — plain link, no button chrome */
  .ps2-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 4px;
    color: var(--ps2-ink);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .ps2-arrow-link span {
    transition: transform 0.15s;
  }

  .ps2-arrow-link:hover {
    color: var(--ps2-cobalt);
  }

  .ps2-arrow-link:hover span {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ps2-arrow-link span {
      transition: none;
    }
  }

  /* hero site-check teaser — a live, functional preview of the free tool */
  .ps2-check {
    position: relative;
  }

  .ps2-check-glow {
    position: absolute;
    inset: -10% -8%;
    background: var(--ps2-gradient);
    filter: blur(64px);
    opacity: 0.35;
    z-index: 0;
    border-radius: 40px;
  }

  .ps2-check-card {
    position: relative;
    z-index: 1;
    background: #fff;
    border: 1px solid var(--ps2-line);
    border-radius: 18px;
    padding: 36px 38px 32px;
    box-shadow: 0 30px 60px -28px rgba(36, 28, 20, 0.28);
  }

  .ps2-check-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ps2-sans);
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ps2-cobalt);
  }

  .ps2-check-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ps2-green);
    animation: ps2-pulse 2.4s ease-in-out infinite;
  }

  .ps2-check-title {
    font-family: var(--ps2-disp);
    font-weight: 800;
    font-size: clamp(22px, 2.2vw, 27px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ps2-ink);
    margin-top: 16px;
  }

  .ps2-check-body {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ps2-ink-soft);
    line-height: 1.6;
  }

  .ps2-check-form {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .ps2-check-form input {
    flex: 1;
    min-width: 0;
    padding: 13px 14px;
    font-size: 14.5px;
    font-family: var(--ps2-sans);
    border: 1px solid var(--ps2-line);
    border-radius: 8px;
    background: var(--ps2-paper);
    color: var(--ps2-ink);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .ps2-check-form input::placeholder {
    color: #A69A88;
  }

  .ps2-check-form input:focus {
    border-color: var(--ps2-cobalt);
    box-shadow: 0 0 0 3px rgba(156, 63, 28, 0.16);
  }

  .ps2-check-form button {
    flex: none;
    border: 0;
    cursor: pointer;
    background: var(--ps2-cobalt);
    color: #fff;
    font-family: var(--ps2-sans);
    font-weight: 600;
    font-size: 14.5px;
    padding: 0 20px;
    border-radius: 8px;
    white-space: nowrap;
    transition: background 0.15s, transform 0.15s;
  }

  .ps2-check-form button:hover {
    background: var(--ps2-cobalt-deep);
    transform: translateY(-1px);
  }

  .ps2-check-rings {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px dashed var(--ps2-line);
  }

  .ps2-check-ring {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ps2-check-ring-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid var(--ps2-line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ps2-disp);
    font-weight: 700;
    font-size: 13px;
    color: #C9B8A4;
    flex: none;
  }

  .ps2-check-ring-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ps2-ink-soft);
  }

  .ps2-check-hint {
    margin-left: auto;
    font-family: var(--ps2-mono);
    font-size: 12px;
    color: #A69A88;
  }

  @media (prefers-reduced-motion: reduce) {
    .ps2-check-dot {
      animation: none;
    }

    .ps2-check-form button {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .ps2-hero .ps2-wrap {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 520px) {
    .ps2-check-card {
      padding: 28px 24px 26px;
    }

    .ps2-check-form {
      flex-direction: column;
    }

    .ps2-check-rings {
      flex-wrap: wrap;
      row-gap: 12px;
    }

    .ps2-check-hint {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /* ---------- ticker ---------- */
  .ps2-ticker {
    border-top: 1px solid var(--ps2-line);
    border-bottom: 1px solid var(--ps2-line);
    overflow: hidden;
    background: #fff;
  }

  .ps2-ticker-track {
    display: flex;
    width: max-content;
    animation: ps2-scroll 38s linear infinite;
    padding: 13px 0;
  }

  .ps2-ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes ps2-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .ps2-ticker span {
    font-family: var(--ps2-mono);
    font-size: 13px;
    color: var(--ps2-ink-soft);
    padding: 0 26px;
    white-space: nowrap;
  }

  .ps2-ticker span::after {
    content: '\00B7';
    margin-left: 52px;
    color: var(--ps2-cobalt);
  }

  /* ---------- sections ---------- */
  .ps2-section {
    padding: 96px 0;
  }

  .ps2-section--clay {
    background: var(--ps2-paper-tint);
  }

  .ps2-sec-head {
    margin-bottom: 56px;
    max-width: 640px;
  }

  .ps2-h2 {
    font-family: var(--ps2-disp);
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 42px);
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin-top: 14px;
    color: var(--ps2-ink);
  }

  .ps2-sec-head p {
    margin-top: 16px;
    color: var(--ps2-ink-soft);
    font-size: 18px;
  }

  /* diff grid */
  .ps2-diffgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--ps2-line);
    border: 1px solid var(--ps2-line);
    border-radius: 12px;
    overflow: hidden;
  }

  .ps2-diff {
    background: #fff;
    padding: 34px 32px;
  }

  .ps2-diff-before {
    font-family: var(--ps2-mono);
    font-size: 14px;
    color: var(--ps2-broken);
    display: flex;
    gap: 10px;
    line-height: 1.7;
  }

  .ps2-diff-before s {
    color: var(--ps2-ink-soft);
    text-decoration-color: var(--ps2-broken);
    text-decoration-thickness: 1.5px;
  }

  .ps2-diff-after {
    font-family: var(--ps2-mono);
    font-size: 14px;
    color: var(--ps2-cobalt);
    display: flex;
    gap: 10px;
    margin-top: 10px;
    line-height: 1.7;
    font-weight: 500;
  }

  .ps2-diff h3 {
    font-family: var(--ps2-disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin-top: 20px;
    color: var(--ps2-ink);
  }

  .ps2-diff p {
    margin-top: 8px;
    color: var(--ps2-ink-soft);
    font-size: 15.5px;
  }

  @media (max-width: 800px) {
    .ps2-diffgrid {
      grid-template-columns: 1fr;
    }
  }

  /* process */
  .ps2-process {
    background: var(--ps2-panel);
  }

  .ps2-process .ps2-eyebrow {
    color: var(--ps2-cobalt-light);
  }

  .ps2-process .ps2-h2 {
    color: #fff;
  }

  .ps2-process .ps2-sec-head p {
    color: var(--ps2-panel-text);
  }

  .ps2-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--ps2-panel-line);
    border: 1px solid var(--ps2-panel-line);
    border-radius: 12px;
    overflow: hidden;
    counter-reset: ps2step;
  }

  .ps2-step {
    background: var(--ps2-panel);
    padding: 32px 26px 36px;
  }

  .ps2-step::before {
    counter-increment: ps2step;
    content: '0' counter(ps2step);
    font-family: var(--ps2-mono);
    font-size: 13px;
    color: var(--ps2-cobalt-light);
  }

  .ps2-step h3 {
    font-family: var(--ps2-disp);
    font-weight: 700;
    font-size: 19px;
    margin: 16px 0 10px;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .ps2-step p {
    font-size: 15px;
    color: var(--ps2-panel-text);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .ps2-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .ps2-steps {
      grid-template-columns: 1fr;
    }
  }

  /* testimonial */
  .ps2-stars {
    color: var(--ps2-cobalt);
    font-size: 15px;
    letter-spacing: 4px;
  }

  .ps2-quote {
    font-family: var(--ps2-disp);
    font-weight: 600;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 22em;
    margin-top: 22px;
    color: var(--ps2-ink);
  }

  .ps2-quote em {
    color: var(--ps2-cobalt);
    font-style: normal;
  }

  .ps2-attrib {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ps2-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ps2-gradient);
    color: #fff;
    font-family: var(--ps2-sans);
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ps2-attrib b {
    display: block;
    font-size: 15.5px;
    color: var(--ps2-ink);
  }

  .ps2-attrib span {
    font-size: 14px;
    color: var(--ps2-ink-soft);
  }

  .ps2-verified {
    font-family: var(--ps2-mono);
    font-size: 12px;
    color: var(--ps2-ink-soft);
    margin-left: auto;
    text-decoration: none;
    border-bottom: 1px solid var(--ps2-line);
  }

  .ps2-verified:hover {
