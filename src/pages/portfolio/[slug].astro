---
import Layout from '../../layouts/Layout.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { projects, isPending } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { result, testimonial } = project;
---

<Layout
  title={`${project.name} — ${project.tagline} | PromoStrats`}
  description={`${project.name}: what was wrong with the site, what I changed, and what happened after.`}
>
  <section class="ps2p">
    <div class="ps2-wrap">
      <a class="ps2p-back" href="/portfolio"><span>&larr;</span> All work</a>

      <header class="ps2p-head">
        <div class="ps2p-head-row">
          <span class="ps2-eyebrow">case {project.number}</span>
          <span class="ps2p-scope">{project.scope}</span>
        </div>
        <h1>{project.name}</h1>
        <p class="ps2p-lede">{project.tagline}</p>
        {project.status === 'in-progress' && <p class="ps2p-status">In progress — not live yet</p>}
      </header>

      {project.compares.map((cmp, i) => <BeforeAfter {...cmp} eager={i === 0} />)}

      <div class="ps2p-body">
        <div class="ps2p-story">
          <section class="ps2p-block">
            <h2>What was wrong</h2>
            <p set:html={project.problem} />
          </section>

          <section class="ps2p-block">
            <h2>What changed</h2>
            <p set:html={project.changed} />
          </section>

          <section class="ps2p-block">
            <h2>What happened after</h2>
            {
              isPending(result) ? (
                <p class="ps2p-pending">{result.pending}</p>
              ) : (
                <p set:html={result} />
              )
            }
          </section>

          {
            isPending(testimonial) ? (
              <p class="ps2p-pending">{testimonial.pending}</p>
            ) : (
              <figure class="ps2p-quote">
                <blockquote>&ldquo;{testimonial.text}&rdquo;</blockquote>
                <figcaption>
                  <b>{testimonial.name}</b>
                  <span>{testimonial.role}</span>
                  {testimonial.source && (
                    <a href={testimonial.source} target="_blank" rel="noopener">
                      verified google review &nearr;
                    </a>
                  )}
                </figcaption>
              </figure>
            )
          }
        </div>

        <aside class="ps2p-side">
          {
            project.changelog.length > 0 && (
              <div class="ps2p-changelog">
                <div class="ps2p-changelog-title">What changed</div>
                {project.changelog.map((l) =>
                  l.type === 'del' ? (
                    <div class="ps2p-cl-line ps2p-cl-line--del">
                      <span class="ps2p-cl-mark">-</span>
                      <s>{l.text}</s>
                    </div>
                  ) : (
                    <div class="ps2p-cl-line ps2p-cl-line--add">
                      <span class="ps2p-cl-mark">+</span>
                      {l.text}
                    </div>
                  )
                )}
              </div>
            )
          }

          {
            project.live && (
              <a class="ps2p-live" href={project.live} target="_blank" rel="noopener">
                View live site <span>&nearr;</span>
              </a>
            )
          }
        </aside>
      </div>
    </div>

    <div class="ps2p-cta">
      <div class="ps2-wrap">
        <span class="ps2-eyebrow">next step</span>
        <h2>Got a shop like this one?</h2>
        <p>
          Tell me what your site isn't doing for you and I'll walk you through exactly what I'd change: structure,
          usability and SEO.
        </p>
        <a class="ps2p-cta-btn" href="/contact">Book your free strategy call</a>
        <div class="ps2p-cta-note">free 20-min call &middot; you keep the advice either way</div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- back link + header ---------- */
  .ps2p-back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 40px;
    font-family: var(--ps2-mono);
    font-size: 13px;
    color: var(--ps2-ink-soft);
    text-decoration: none;
  }

  .ps2p-back:hover {
    color: var(--ps2-accent);
  }

  .ps2p-back span {
    transition: transform 0.15s;
  }

  .ps2p-back:hover span {
    transform: translateX(-3px);
  }

  .ps2p-head {
    padding: 26px 0 8px;
  }

  .ps2p-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 20px;
  }

  .ps2p-scope {
    margin-left: auto;
    font-family: var(--ps2-mono);
    font-size: 12.5px;
    color: var(--ps2-ink-soft);
  }

  .ps2p-head h1 {
    font-family: var(--ps2-disp);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.04;
    margin-top: 16px;
  }

  .ps2p-lede {
    margin-top: 14px;
    font-size: 18px;
    color: var(--ps2-ink-soft);
  }

  .ps2p-status {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--ps2-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ps2-ink);
    background: var(--ps2-paper-tint);
    border: 1px solid var(--ps2-line);
    padding: 6px 12px;
    border-radius: 20px;
  }

  /* ---------- story ---------- */
  .ps2p-body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    margin-top: 52px;
    padding-bottom: clamp(48px, 6vw, 88px);
    align-items: start;
  }

  .ps2p-story {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ps2p-block h2 {
    font-family: var(--ps2-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ps2-accent);
    margin-bottom: 14px;
  }

  .ps2p-block p {
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--ps2-ink-soft);
  }

  .ps2p-block :global(strong) {
    color: var(--ps2-ink);
    font-weight: 600;
  }

  /* uncollected result/testimonial — visibly a gap, not a claim */
  .ps2p-pending {
    font-family: var(--ps2-mono);
    font-size: 13px;
    color: var(--ps2-ink-soft);
    background: var(--ps2-paper-tint);
    border: 1px dashed var(--ps2-line);
    border-radius: 8px;
    padding: 14px 16px;
  }

  /* ---------- testimonial ---------- */
  .ps2p-quote {
    margin: 0;
    border-left: 2px solid var(--ps2-accent);
    padding-left: 24px;
  }

  .ps2p-quote blockquote {
    margin: 0;
    font-family: var(--ps2-disp);
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .ps2p-quote figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 18px;
    font-family: var(--ps2-mono);
    font-size: 12.5px;
    color: var(--ps2-ink-soft);
  }

  .ps2p-quote figcaption b {
    color: var(--ps2-ink);
    font-weight: 600;
  }

  .ps2p-quote figcaption a {
    color: var(--ps2-accent);
    text-decoration: none;
  }

  .ps2p-quote figcaption a:hover {
    text-decoration: underline;
  }

  /* ---------- side column ---------- */
  .ps2p-side {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .ps2p-changelog {
    border: 1px solid var(--ps2-line);
    background: #fff;
    border-radius: 12px;
    padding: 22px 24px;
    font-family: var(--ps2-mono);
    font-size: 13.5px;
    line-height: 2;
  }

  .ps2p-changelog-title {
    color: var(--ps2-ink-soft);
    font-size: 12px;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .ps2p-cl-line {
    display: flex;
    gap: 10px;
  }

  .ps2p-cl-line .ps2p-cl-mark {
    width: 12px;
    flex: none;
  }

  .ps2p-cl-line--del {
    color: var(--ps2-broken);
  }

  .ps2p-cl-line--del s {
    color: var(--ps2-ink-soft);
    text-decoration-color: var(--ps2-broken);
    text-decoration-thickness: 1.5px;
  }

  .ps2p-cl-line--add {
    color: var(--ps2-accent);
    font-weight: 500;
  }

  .ps2p-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-size: 15px;
    font-weight: 600;
    color: var(--ps2-ink);
    text-decoration: none;
    padding: 11px 20px;
    border: 1px solid var(--ps2-line);
    border-radius: 6px;
    background: transparent;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }

  .ps2p-live:hover {
    background: #fff;
    border-color: var(--ps2-ink);
    transform: translateY(-1px);
  }

  .ps2p-live span {
    transition: transform 0.15s;
  }

  .ps2p-live:hover span {
    transform: translateX(3px);
  }

  /* ---------- cta ---------- */
  .ps2p-cta {
    background: var(--ps2-accent);
    text-align: center;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  .ps2p-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ps2-gradient);
    opacity: 0.22;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .ps2p-cta > .ps2-wrap {
    position: relative;
  }

  .ps2p-cta :global(.ps2-eyebrow) {
    color: var(--ps2-paper);
  }

  .ps2p-cta :global(.ps2-eyebrow)::before {
    background: #fff;
    opacity: 0.7;
  }

  .ps2p-cta h2 {
    font-family: var(--ps2-disp);
    font-weight: 700;
    letter-spacing: -0.025em;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.08;
    color: #fff;
    max-width: 18em;
    margin: 14px auto 0;
  }

  .ps2p-cta p {
    margin: 20px auto 36px;
    color: #F0DCC8;
    max-width: 46ch;
  }

  .ps2p-cta-btn {
    display: inline-block;
    background: #fff;
    color: var(--ps2-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 30px;
    border-radius: 6px;
    transition: background 0.15s, transform 0.15s;
  }

  .ps2p-cta-btn:hover {
    background: var(--ps2-paper);
    transform: translateY(-1px);
  }

  .ps2p-cta-note {
    margin-top: 20px;
    font-family: var(--ps2-mono);
    font-size: 12.5px;
    color: var(--ps2-paper);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 800px) {
    .ps2p-body {
      grid-template-columns: 1fr;
    }

    .ps2p-scope {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ps2p-back span,
    .ps2p-live,
    .ps2p-live span,
    .ps2p-cta-btn {
      transition: none;
    }
  }
</style>
